# Gate for /vibe-check.
# VIBE_CHECK_CODE   — the six digits you type in
# VIBE_CHECK_SECRET — long random string stored in the cookie; rotate to log out
#                     every device. Generate with:
#                     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VIBE_CHECK_CODE=000000
VIBE_CHECK_SECRET=generate_a_long_random_string
